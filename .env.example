# demo works without either key. Switch explicitly to live after configuring.
APP_MODE=demo
LIARA_API_TOKEN=
CURSOR_API_KEY=
# Optional, server-only GitHub token for private repositories. ZIP needs no token.
GITHUB_TOKEN=
CURSOR_MODEL=composer-2.5
PORT=3001
HOST=127.0.0.1
# Required if exposing beyond localhost. Use a long random password.
DASHBOARD_PASSWORD=
# Demo: 5000. For live production monitoring use 60000 or higher.
MONITOR_INTERVAL_MS=5000
MONITOR_FAILURE_THRESHOLD=3
# Exact IDs this agent may change. Empty = read only in live mode.
LIARA_ALLOWED_APP_IDS=
LIARA_APP_ID=
LIARA_DATABASE_ID=
# URLs for the one managed app. Verify only safe, idempotent endpoints.
APP_HEALTH_URL=
APP_BUSINESS_CHECK_URL=
# Optional team header
LIARA_TEAM_ID=
# Demo app stays local; never set this to a production service.
DEMO_APP_URL=http://127.0.0.1:3002
DEMO_CONTROL_TOKEN=hamrah-local-demo-only
DATA_DIR=./data
