{
  "name": "hamrah-cloud-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx server/launcher.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/launcher.ts",
    "demo": "tsx demo/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server tests demo *.json *.ts *.yaml README.md docs/*.md"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.40",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "yauzl": "^3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.10",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/tar": "^6.1.13",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "yaml": "^2.8.1"
  }
}
